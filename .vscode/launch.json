{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "practice（选择章节）",
      "type": "debugpy",
      "request": "launch",
      "python": "D:/Miniconda3/envs/agent-learn/python.exe",
      "debugAdapterPython": "D:/Miniconda3/envs/agent-learn/python.exe",
      "debugLauncherPython": "D:/Miniconda3/envs/agent-learn/python.exe",
      "program": "${workspaceFolder}/practice.py",
      "args": [
        "${input:chapter}",
        "run"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "justMyCode": true,
      "subProcess": true,
      "env": {
        "SSL_CERT_FILE": "D:/Miniconda3/envs/agent-learn/Lib/site-packages/certifi/cacert.pem",
        "PYTHONUTF8": "1",
        "PYTHONUNBUFFERED": "1",
        "MCP_DEBUG_TIMEOUT_SECONDS": "3600",
        "MODEL_PROVIDER": "${input:modelProvider}"
      }
    }
  ],
  "inputs": [
    {
      "id": "chapter",
      "type": "pickString",
      "description": "选择要调试的章节",
      "options": [
        {
          "label": "P1 基础概念",
          "value": "1"
        },
        {
          "label": "P2 工具调用",
          "value": "2"
        },
        {
          "label": "P3 RAG：检索与上下文",
          "value": "3-rag"
        },
        {
          "label": "P3 MemGPT：分层记忆循环",
          "value": "3-memgpt"
        },
        {
          "label": "P4 多智能体",
          "value": "4"
        },
        {
          "label": "P5 LangGraph：计划、确认与恢复",
          "value": "5-langgraph"
        },
        {
          "label": "P5 OpenAI Agents SDK：工具调用与计划生成",
          "value": "5-agents_sdk"
        },
        {
          "label": "P6 评测",
          "value": "6"
        }
      ],
      "default": "1"
    },
    {
      "id": "modelProvider",
      "type": "pickString",
      "description": "选择模型",
      "options": [
        "scripted",
        "deepseek"
      ],
      "default": "scripted"
    }
  ]
}
